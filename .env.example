# Clickstream - local development environment
# Copy to .env and adjust as needed. Services and `docker compose` read these.

# Kafka (KRaft)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=clicks.raw
KAFKA_TOPIC_DLQ=clicks.dlq

# Producer
PRODUCER_RATE=100
PRODUCER_DURATION=600
PRODUCER_MAX_EVENTS=100000
PRODUCER_SEED=42
PRODUCER_TOPIC=clicks.raw

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=click
POSTGRES_PASSWORD=click
POSTGRES_DB=clickstream

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=olap

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API
API_PORT=8000

# Spark job
SPARK_SINK_MODE=console
SPARK_CHECKPOINT_LOCATION=/tmp/clickstream-checkpoints

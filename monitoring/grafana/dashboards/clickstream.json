  "panels": [
    {
      "type": "timeseries",
      "title": "Kafka Consumer Lag (by topic)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (topic) (kafka_consumergroup_lag)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Kafka Produce Rate - clicks.raw (events/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(kafka_broker_topic_messages_in{topic=\"clicks.raw\"}[1m]))",
          "legendFormat": "events/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "eps" },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "DLQ Depth - clicks.dlq (end offset)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(kafka_topic_end_offset{topic=\"clicks.dlq\"})",
          "legendFormat": "messages",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
